<section class="custom-section">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>

    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | img_url: 'medium' }}" alt="Custom Section Image">
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-section__blocks">
        {%- for block in section.blocks -%}
          <div class="custom-section__block" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.block_title }}</h3>
            <p>{{ block.settings.block_text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Section",
  "tag": "section",
  "class": "custom-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to My Custom Section"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "This is a custom section created for the Dawn theme."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title",
          "default": "Block Heading"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Block Text",
          "default": "This is a custom block inside the section."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Section",
      "blocks": [
        {
          "type": "content_block"
        }
      ]
    }
  ]
}
{% endschema %}
