<div class="custom-header-section">
  <div class="page-width">
    {%- if section.settings.text != blank -%}
      <p class="custom-header-text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="custom-header-link">
        {{ section.settings.link_text }}
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-header-blocks">
        {%- for block in section.blocks -%}
          <div class="custom-header-block" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.block_title }}</h3>
            <p>{{ block.settings.block_text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Header Section",
  "tag": "section",
  "class": "custom-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Welcome to My Store!"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content Block",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title",
          "default": "Block Heading"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Block Text",
          "default": "This is a custom block inside the header."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header Section",
      "blocks": [
        {
          "type": "content_block"
        }
      ]
    }
  ]
}
{% endschema %}