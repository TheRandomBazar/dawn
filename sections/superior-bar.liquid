{%- liquid
  if section.blocks.size > 0
    assign superior_bar = true
  endif
-%}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% endif %}"
>
  <div class="page-width utility-bar__grid">
    {% assign min = 1 %}
    {% assign max = section.blocks.size | plus: 1 %}
    {% assign diff = max | minus: min %}
    {% assign randomNumber = 'now' | date: '%N' | modulo: diff | plus: min %}

    {% assign enable_led = section.settings.enable_led_effect %}

    {%- for block in section.blocks -%}
      {% if randomNumber == forloop.index %}
        {% if enable_led %}
          <canvas id="ledCanvas-{{ section.id }}"></canvas>
        {% else %}
          <marquee
            class="grid grid--1-col"
            id="Message-{{ section.id }}"
            direction="{{ section.settings.direction }}"
            behavior="{{ section.settings.behaviour }}"
            scrollamount="{{ section.settings.change_slides_speed }}"
            {{ block.shopify_attributes }}
            style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;"
          >
            {%- if block.settings.text != blank -%}
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  class="superior-bar__link link link--text focus-inset animate-arrow"
                >
              {%- endif -%}
              <p class="superior-bar__message h5">
                <span>{{ block.settings.text | escape }}</span>
                {%- if block.settings.link != blank -%}
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                {%- endif -%}
              </p>
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            {%- endif -%}
          </marquee>
        {% endif %}
      {% endif %}
    {%- endfor -%}
  </div>
</div>

{% if enable_led %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const canvas = document.getElementById("ledCanvas-{{ section.id }}");
      if (!canvas) return;
      
      const ctx = canvas.getContext("2d");

      const CANVAS_WIDTH = window.innerWidth;
      const CANVAS_HEIGHT = 120; 
      const DOT_SIZE = 3;  
      const SPACING = 5;
      const TEXT_COLOR = "{{ section.settings.text_color }}";
      const BG_COLOR = "black";
      const TEXT_SPEED = {{ section.settings.change_slides_speed }};
      const TEXT_SIZE = {{ section.settings.text_size }};
      const FONT = "{{ section.settings.text_font }}";

      canvas.width = CANVAS_WIDTH;
      canvas.height = CANVAS_HEIGHT;
      let text = `{{ section.blocks[randomNumber].settings.text | escape }}`;
      let xPos = CANVAS_WIDTH;

      function drawLEDText() {
        ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        ctx.fillStyle = TEXT_COLOR;
        ctx.font = "bold " + TEXT_SIZE + "px " + FONT;
        ctx.textBaseline = "middle";

        let textWidth = ctx.measureText(text).width;
        ctx.fillText(text, xPos, CANVAS_HEIGHT / 2);

        let imageData = ctx.getImageData(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

        for (let y = 0; y < CANVAS_HEIGHT; y += SPACING) {
          for (let x = 0; x < CANVAS_WIDTH; x += SPACING) {
            let pixelIndex = (y * CANVAS_WIDTH + x) * 4;
            let brightness = imageData.data[pixelIndex];

            if (brightness > 20) {
              ctx.fillStyle = TEXT_COLOR;
              ctx.beginPath();
              ctx.arc(x, y, DOT_SIZE / 2, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }

        xPos -= TEXT_SPEED;
        if (xPos < -textWidth) {
          xPos = CANVAS_WIDTH;
        }

        requestAnimationFrame(drawLEDText);
      }

      drawLEDText();
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Superior Bar",
  "max_blocks": 12,
  "class": "superior-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_led_effect",
      "default": false,
      "label": "Enable LED Effect"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FF00"
    },
    {
      "type": "select",
      "id": "text_font",
      "options": [
        {
          "value": "Press Start 2P",
          "label": "Press Start 2P"
        },
        {
          "value": "Electrolize",
          "label": "Electrolize"
        },
        {
          "value": "Courier New",
          "label": "Courier New"
        }
      ],
      "default": "Press Start 2P",
      "label": "Font Family"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 26
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Scroll Direction"
    },
    {
      "type": "select",
      "id": "behaviour",
      "options": [
        { "value": "scroll", "label": "Scroll" },
        { "value": "slide", "label": "Slide" },
        { "value": "alternate", "label": "Alternate" }
      ],
      "default": "scroll",
      "label": "Scroll Behaviour"
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Scroll Speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "superior",
      "name": "Marquee Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Cyberpunk Hacker Mode: ON",
          "label": "Text Content"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LED Marquee",
      "blocks": [
        {
          "type": "superior"
        }
      ]
    }
  ]
}
{% endschema %}
