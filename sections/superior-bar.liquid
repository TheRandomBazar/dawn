{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.blocks.size > 0
    assign superior_bar = true
  endif
-%}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% endif %}"
>
  <div class="page-width utility-bar__grid">
    Blocks = {{ section.blocks.size }}
    {% assign min = 1 %}
    {% assign max = section.blocks.size | plus: 1 %}
    {% assign diff = max | minus: min %}
    {% assign randomNumber = 'now' | date: '%N' | modulo: diff | plus: min %}
    Random = {{ randomNumber }}

    {%- for block in section.blocks -%}
      {{- forloop.index }}
      {% if randomNumber == forloop.index %}
        YESSS equal!! Random = {{ randomNumber }} Index = {{ forloop.index }}
      {% endif %}

      <marquee
        class="grid grid--1-col"
        id="Slider-{{ section.id }}"
        direction="{{ section.settings.direction }}"
        behavior="scroll"
        scrollamount="{{ section.settings.change_slides_speed }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a
              href="{{ block.settings.link }}"
              class="superior-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="superior-bar__message h5">
            <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </marquee>
    {%- endfor -%}

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
      <style>
        /* theme editor power preview fix */
        .superior-bar-slider .slider__slide[aria-hidden='true'] {
          visibility: hidden;
        }
      </style>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.superior-bar.name",
  "max_blocks": 12,
  "class": "superior-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        {
          "value": "left",
          "label": "left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "down",
          "label": "Down"
        }
      ],
      "default": "left",
      "label": "Scroll direction",
      "info": "The scrolling direction of the text"
    },
    {
      "type": "select",
      "id": "behaviour",
      "options": [
        {
          "value": "scroll",
          "label": "scroll"
        },
        {
          "value": "slide",
          "label": "slide"
        },
        {
          "value": "alternate",
          "label": "alternate"
        }
      ],
      "default": "scroll",
      "label": "Scroll behaviour",
      "info": "Sets how the text is scrolled within the marquee."
    },
    {
      "type": "header",
      "content": "t:sections.superior-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.superior-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.superior-bar.settings.change_slides_speed.label",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "superior",
      "name": "t:sections.superior-bar.blocks.superior.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.superior-bar.blocks.superior.settings.text.default",
          "label": "t:sections.superior-bar.blocks.superior.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.superior-bar.blocks.superior.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.superior-bar.presets.name",
      "blocks": [
        {
          "type": "superior"
        }
      ]
    }
  ]
}
{% endschema %}
